# Never commit the real values copied from this template.
AIP_IDENTITY_BINDING_ENABLED=true

LEADER_AIC=REPLACE_AFTER_REGISTRY_APPROVAL
SOURCE_VERIFIER_AIC=REPLACE_AFTER_REGISTRY_APPROVAL
EVIDENCE_GRADER_AIC=REPLACE_AFTER_REGISTRY_APPROVAL
CONTRADICTION_SCOUT_AIC=REPLACE_AFTER_REGISTRY_APPROVAL

SOURCE_VERIFIER_URL=https://source.example.invalid/rpc
EVIDENCE_GRADER_URL=https://grader.example.invalid/rpc
CONTRADICTION_SCOUT_URL=https://contradiction.example.invalid/rpc

AIP_CLIENT_CA_FILE=/run/secrets/trust-bundle.pem
AIP_CLIENT_CERT_FILE=/run/secrets/leader-cert.pem
AIP_CLIENT_KEY_FILE=/run/secrets/leader-key.pem

# Each Partner process receives its own AGENT_AIC, application import path,
# port, and serverAuth certificate files. Start it with:
# python -m evidence_mesh.serve_partner
AGENT_AIC=REPLACE_PER_PARTNER_PROCESS
PARTNER_APP=evidence_mesh.source_partner:app
AIP_SERVER_PORT=8443
AIP_SERVER_CA_FILE=/run/secrets/trust-bundle.pem
AIP_SERVER_CERT_FILE=/run/secrets/partner-cert.pem
AIP_SERVER_KEY_FILE=/run/secrets/partner-key.pem
