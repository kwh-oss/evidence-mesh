# Copy to deploy/.env.server on the server. Never commit the real file.
PUBLIC_HOST=agents.example.com
PROVIDER_OR_TEAM_NAME=replace-me

# Assigned only after Registry approval.
LEADER_AIC=replace-after-approval
SOURCE_VERIFIER_AIC=replace-after-approval
EVIDENCE_GRADER_AIC=replace-after-approval
CONTRADICTION_SCOUT_AIC=replace-after-approval

# Enable only after every Partner has a clientAuth certificate and the official
# ACPs infrastructure CA has been installed as infrastructure-ca.pem.
GROUP_ENABLED=false
