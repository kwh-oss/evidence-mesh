# Disabled until private configuration and a bounded real-call test are approved.
EVIDENCE_SEMANTIC_ENABLED=false
# Set the exact model name available in your DeepSeek account; do not leave blank when enabling.
DEEPSEEK_MODEL=
# Container-side private file. Mount read-only; never include the key in this file.
DEEPSEEK_API_KEY_FILE=/run/models/deepseek.key
DEEPSEEK_MAX_CALLS=4
# Writable backend-only mount; attempts survive process/container restarts.
DEEPSEEK_BUDGET_FILE=/var/lib/evidence-model-budget/quota.sqlite3
